# Build artifacts
build/
build-*/
out/
cmake-build-*/
CMakeUserPresets.json

# Compiled objects / binaries / debug symbols
*.o
*.obj
*.a
*.so
*.dylib
*.dSYM/
*.dwarf

# macOS
.DS_Store

# Proprietary / user-supplied game & console assets (never committed)
games/*
!games/.gitkeep

# Defense-in-depth: ignore common PS4/Orbis proprietary artifacts anywhere
*.pkg
*.prx
*.sprx
*.self
eboot.bin
sce_sys/
sce_module/

# IDE / editor
.idea/
.vscode/
*.swp

# Emulator run logs (can reach GBs; regenerated every run, never published)
flappy_*.txt
log.txt

# Python bytecode caches
__pycache__/

# Agent working-memory directories (machine-local session notes)
.agents/
.superpowers/

# GUI run logs
Logs/

# scratch run logs from ps4-runner invocations
*.log
*.log
dump_code_*.bin
